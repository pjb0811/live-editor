# Kept intentionally: the docs website (website/, a separate Docusaurus app)
# builds @jbpark/ui-kit's un-bundled dist with webpack, which resolves ui-kit's
# externalized transitive deps (scheduler, @radix-ui/*, @tiptap/*, gsap, motion,
# ...) only via this flat layout. Removing it breaks `pnpm --dir website build`.
# The dependency-hygiene it used to mask for THIS package is now caught by the
# `depcheck` CI step instead (see #282). Verified: dropping this fails the
# website build with a cascade of "Module not found" errors.
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
