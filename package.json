{
  "name": "@jbpark/live-editor",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "1.13.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Interactive UI editor with real-time preview and drag-and-drop. Syncs canvas edits back to source code via AST transforms and renders the preview in an iframe for DOM/CSS isolation (not a security sandbox).",
  "keywords": [
    "live-editor",
    "ui-editor",
    "react",
    "typescript",
    "vite",
    "codemirror",
    "babel",
    "ast",
    "dnd",
    "dnd-kit",
    "tailwindcss",
    "sandbox",
    "preview"
  ],
  "author": "jbpark",
  "license": "MIT",
  "homepage": "https://live-editor.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjb0811/live-editor.git"
  },
  "bugs": {
    "url": "https://github.com/pjb0811/live-editor/issues"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.29.3",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/ast": {
      "types": "./dist/utils/ast/index.d.ts",
      "import": "./dist/utils/ast/index.js"
    },
    "./utils/tailwind": {
      "types": "./dist/utils/tailwind/index.d.ts",
      "import": "./dist/utils/tailwind/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm check-types && tsdown",
    "build:demo": "vite build --outDir dist-demo",
    "build:demos": "vite build --config demos/vite.config.ts",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.8",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/merge": "^6.12.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jbpark/ui-kit": "^5.3.0",
    "@jbpark/use-hooks": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^1.31.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "prettier": "^3.8.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsdown/css": "^0.22.14",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "baseline-browser-mapping": "^2.11.14",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write",
    "**/*.{js,jsx,ts,tsx}": [
      "bash -c 'pnpm lint'",
      "bash -c 'tsc -b'"
    ]
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "^6.7.1"
    }
  }
}
