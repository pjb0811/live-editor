{
  "name": "@jbpark/live-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Interactive UI editor with real-time preview and drag-and-drop. Syncs canvas edits back to source code via AST transforms and renders the preview in an iframe for DOM/CSS isolation (not a security sandbox).",
  "keywords": [
    "live-editor",
    "ui-editor",
    "react",
    "typescript",
    "vite",
    "codemirror",
    "babel",
    "ast",
    "dnd",
    "dnd-kit",
    "tailwindcss",
    "ant-design",
    "sandbox",
    "preview"
  ],
  "author": "jbpark",
  "license": "MIT",
  "homepage": "https://pjb0811.github.io/live-editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjb0811/live-editor.git"
  },
  "bugs": {
    "url": "https://github.com/pjb0811/live-editor/issues"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.29.3",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./utils/ast": {
      "types": "./dist/utils/ast.d.ts",
      "import": "./dist/utils/ast.js"
    },
    "./utils/tailwind": {
      "types": "./dist/utils/tailwind.d.ts",
      "import": "./dist/utils/tailwind.js"
    },
    "./style.css": "./dist/live-editor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm check-types && tsdown",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "sync:draggable-items": "node scripts/sync-draggable-items.mjs",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@babel/standalone": "^7.28.4",
    "@codemirror/lang-javascript": "^6.2.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jbpark/ui-kit": "^2.3.4",
    "@tailwindcss/vite": "^4.1.13",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@uiw/codemirror-theme-vscode": "^4.25.1",
    "@uiw/react-codemirror": "^4.25.1",
    "antd": "^6.2.0",
    "lucide-react": "^0.562.0",
    "react-router-dom": "^7.12.0",
    "tailwindcss": "^4.1.13",
    "uuid": "^12.0.0"
  },
  "peerDependencies": {
    "prettier": "^3.8.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.9.11",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-classnames": "^0.8.2",
    "prettier-plugin-merge": "^0.8.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.4.0",
    "tsdown": "^0.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write",
    "**/*.{js,jsx,ts,tsx}": [
      "bash -c 'pnpm lint'",
      "bash -c 'tsc -b'"
    ]
  }
}
