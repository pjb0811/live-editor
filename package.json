    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.87.1",
    "@uiw/codemirror-theme-vscode": "^4.25.1",
    "@uiw/react-codemirror": "^4.25.1",
    "antd": "^5.27.3",
    "axios": "^1.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-use": "^17.6.0",
    "tailwindcss": "^4.1.13",
    "use-hooks": "github:pjb0811/use-hooks",
