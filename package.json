{
  "name": "@jbpark/live-editor",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.1",
    "@babel/standalone": "^7.28.4",
    "@codemirror/lang-javascript": "^6.2.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jbpark/ui-kit": "^1.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.87.1",
    "@uiw/codemirror-theme-vscode": "^4.25.1",
    "@uiw/react-codemirror": "^4.25.1",
    "antd": "^6.1.2",
    "axios": "^1.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-use": "^17.6.0",
    "tailwindcss": "^4.1.13",
    "uuid": "^12.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@uidotdev/usehooks": "^2.4.1",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.9.11",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-classnames": "^0.8.2",
    "prettier-plugin-merge": "^0.8.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwind-merge": "^3.3.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write",
    "**/*.{js,jsx,ts,tsx}": [
      "bash -c 'npm run lint'",
      "bash -c 'tsc -b'"
    ]
  }
}
