{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --dir website build",
  "outputDirectory": "website/build",
  "installCommand": "pnpm install && pnpm --dir website install",
  "headers": [
    {
      "source": "/demos/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
